# Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgres://power:your_secure_password@localhost:5432/power_energy
DATABASE_POOL_SIZE=20

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_MEMORY=256mb

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET=your_very_long_random_secret_string_at_least_32_characters
JWT_EXPIRY=24h

# ===========================================
# API CONFIGURATION
# ===========================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# ===========================================
# EXTERNAL APIS
# ===========================================
# EPEX Spot Prices (optional - mock data used if not set)
EPEX_API_KEY=your_epex_api_key

# Netzbetreiber OAuth (Wiener Netze Example)
WIENER_NETZE_CLIENT_ID=your_client_id
WIENER_NETZE_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:4000/smartmeter/callback

# ===========================================
# EMAIL (Optional)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@power.energy

# ===========================================
# PAYMENT (Optional)
# ===========================================
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===========================================
# MONITORING
# ===========================================
PROMETHEUS_ENABLED=true
GRAFANA_PASSWORD=change_this_password
SENTRY_DSN=your_sentry_dsn

# ===========================================
# FEATURES
# ===========================================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
